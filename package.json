    "react-dom": "^19.2.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@hono/vite-dev-server": "^0.26.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.1",
    "prisma": "^6.19.3",
    "tailwindcss": "^4.3.3",
